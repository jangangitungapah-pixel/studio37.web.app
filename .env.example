# Application environment. Supported intent: development | production
VITE_APP_ENV=development

# Firebase public web-client configuration.
# These are intentionally placeholders in Phase 0; Firebase SDK wiring happens in Phase 2.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Phase 2 may use Firebase Emulator Suite for local development.
VITE_USE_FIREBASE_EMULATORS=false
