rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function currentUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function permissionSetPath(permissionSetId) {
      return /databases/$(database)/documents/permissionSets/$(permissionSetId);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function hasValidOptionalReference(value) {
      return value == null
        || (value is string && value.size() > 0 && value.size() <= 128 && value.matches('^[^/]+$'));
    }

    function hasValidOptionalPhone(value) {
      return value == null
        || (value is string && value.matches('^\\+62[0-9]{8,13}$'));
    }

    function hasValidOptionalEmail(value) {
      return value == null
        || (value is string
          && value.size() > 2
          && value.size() <= 254
          && value.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$'));
    }

    function isValidUserProfile(uid, data) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'phone',
          'role',
          'status',
          'permissionSetId',
          'operatorId',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'phone',
          'role',
          'status',
          'permissionSetId',
          'operatorId',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == uid
        && data.uid.size() > 0
        && data.uid.size() <= 128
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 120
        && data.email is string
        && data.email.size() > 2
        && data.email.size() <= 254
        && hasValidOptionalPhone(data.phone)
        && data.role in ['owner', 'studio_operator']
        && data.status in ['active', 'disabled']
        && hasValidOptionalReference(data.permissionSetId)
        && hasValidOptionalReference(data.operatorId)
        && (data.role != 'owner' || data.permissionSetId == null)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedAt >= data.createdAt;
    }

    function isActiveOwnerProfile(uid, data) {
      return isValidUserProfile(uid, data)
        && data.status == 'active'
        && data.role == 'owner';
    }

    function isActiveUserProfile(uid, data) {
      return isValidUserProfile(uid, data)
        && data.status == 'active';
    }

    function isActiveOwner() {
      return isSignedIn()
        && exists(currentUserPath())
        && isActiveOwnerProfile(request.auth.uid, get(currentUserPath()).data);
    }

    function isActiveUser() {
      return isSignedIn()
        && exists(currentUserPath())
        && isActiveUserProfile(request.auth.uid, get(currentUserPath()).data);
    }

    function canProfileReadPermissionSet(uid, data, permissionSetId) {
      return isValidUserProfile(uid, data)
        && data.status == 'active'
        && (data.role == 'owner'
          || (data.role == 'studio_operator'
            && data.permissionSetId is string
            && data.permissionSetId == permissionSetId));
    }

    function canReadPermissionSet(permissionSetId) {
      return isSignedIn()
        && exists(currentUserPath())
        && canProfileReadPermissionSet(
          request.auth.uid,
          get(currentUserPath()).data,
          permissionSetId
        );
    }

    function canCreateUserProfile(uid) {
      return isSignedIn() && uid != request.auth.uid && isActiveOwner();
    }

    function canUpdateUserProfile(uid, existingData) {
      return isSignedIn()
        && ((uid == request.auth.uid && isActiveOwnerProfile(uid, existingData))
          || (uid != request.auth.uid && isActiveOwner()));
    }

    function hasOnlyDelegableCapabilities(capabilities) {
      return capabilities is list
        && capabilities.size() <= 23
        && capabilities.hasOnly([
          'booking.cancel',
          'booking.create',
          'booking.edit',
          'booking.override_price',
          'booking.view',
          'bookkeeping.create',
          'bookkeeping.view',
          'commission.adjust',
          'commission.payout',
          'commission.view_all',
          'commission.view_own',
          'customer.edit',
          'customer.view',
          'dashboard.view',
          'payment.adjust',
          'payment.create',
          'payment.view',
          'settings.operators.manage',
          'settings.operators.view',
          'settings.pricing.edit',
          'settings.pricing.view',
          'settings.studio.edit',
          'settings.studio.view'
        ]);
    }

    function isValidPermissionSet(data) {
      return data.keys().hasAll([
          'name',
          'status',
          'capabilities',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'name',
          'status',
          'capabilities',
          'createdAt',
          'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.status in ['active', 'disabled']
        && hasOnlyDelegableCapabilities(data.capabilities)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedAt >= data.createdAt;
    }

    function activeProfileHasCapability(profile, capability) {
      return profile.role == 'studio_operator'
        && profile.permissionSetId is string
        && exists(permissionSetPath(profile.permissionSetId))
        && isValidPermissionSet(get(permissionSetPath(profile.permissionSetId)).data)
        && get(permissionSetPath(profile.permissionSetId)).data.status == 'active'
        && capability in get(permissionSetPath(profile.permissionSetId)).data.capabilities;
    }

    function hasCapability(capability) {
      return isSignedIn()
        && exists(currentUserPath())
        && isActiveUserProfile(request.auth.uid, get(currentUserPath()).data)
        && (get(currentUserPath()).data.role == 'owner'
          || activeProfileHasCapability(get(currentUserPath()).data, capability));
    }

    function isValidStudioOperatingHours(data, bookingIntervalMinutes) {
      return data is map
        && data.keys().hasAll(['opensAtMinutes', 'closesAtMinutes'])
        && data.keys().hasOnly(['opensAtMinutes', 'closesAtMinutes'])
        && data.opensAtMinutes is int
        && data.closesAtMinutes is int
        && data.opensAtMinutes >= 0
        && data.closesAtMinutes <= 1439
        && data.opensAtMinutes < data.closesAtMinutes
        && data.opensAtMinutes % bookingIntervalMinutes == 0
        && data.closesAtMinutes % bookingIntervalMinutes == 0
        && data.closesAtMinutes - data.opensAtMinutes >= bookingIntervalMinutes;
    }

    function isValidStudioSettings(data) {
      return data.keys().hasAll([
          'businessName',
          'timeZone',
          'operatingHours',
          'bookingIntervalMinutes',
          'createdAt',
          'createdByUid',
          'updatedAt',
          'updatedByUid'
        ])
        && data.keys().hasOnly([
          'businessName',
          'timeZone',
          'operatingHours',
          'bookingIntervalMinutes',
          'createdAt',
          'createdByUid',
          'updatedAt',
          'updatedByUid'
        ])
        && data.businessName is string
        && data.businessName.size() > 0
        && data.businessName.size() <= 120
        && data.timeZone in ['Asia/Jakarta', 'Asia/Makassar', 'Asia/Jayapura']
        && data.bookingIntervalMinutes in [15, 30, 60]
        && isValidStudioOperatingHours(data.operatingHours, data.bookingIntervalMinutes)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedAt >= data.createdAt
        && data.createdByUid is string
        && data.createdByUid.size() > 0
        && data.createdByUid.size() <= 128
        && data.updatedByUid is string
        && data.updatedByUid.size() > 0
        && data.updatedByUid.size() <= 128;
    }

    function isValidStudioRoom(data) {
      return data.keys().hasAll([
          'code',
          'name',
          'description',
          'displayOrder',
          'status',
          'createdAt',
          'createdByUid',
          'updatedAt',
          'updatedByUid'
        ])
        && data.keys().hasOnly([
          'code',
          'name',
          'description',
          'displayOrder',
          'status',
          'createdAt',
          'createdByUid',
          'updatedAt',
          'updatedByUid'
        ])
        && data.code is string
        && data.code.matches('^[A-Z0-9][A-Z0-9-]{0,23}$')
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.description is string
        && data.description.size() <= 240
        && data.displayOrder is int
        && data.displayOrder >= 1
        && data.displayOrder <= 999
        && data.status in ['active', 'disabled']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedAt >= data.createdAt
        && data.createdByUid is string
        && data.createdByUid.size() > 0
        && data.createdByUid.size() <= 128
        && data.updatedByUid is string
        && data.updatedByUid.size() > 0
        && data.updatedByUid.size() <= 128;
    }

    function hasValidOperatorTypes(value) {
      return value is list
        && value.size() >= 1
        && value.size() <= 2
        && value.hasOnly(['studio_operator', 'recording_engineer'])
        && (value.size() == 1 || value[0] != value[1]);
    }

    function isValidOperator(data) {
      return data.keys().hasAll([
          'displayName',
          'email',
          'phone',
          'operatorTypes',
          'linkedUserUid',
          'status',
          'createdAt',
          'createdByUid',
          'updatedAt',
          'updatedByUid'
        ])
        && data.keys().hasOnly([
          'displayName',
          'email',
          'phone',
          'operatorTypes',
          'linkedUserUid',
          'status',
          'createdAt',
          'createdByUid',
          'updatedAt',
          'updatedByUid'
        ])
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 100
        && hasValidOptionalEmail(data.email)
        && hasValidOptionalPhone(data.phone)
        && hasValidOperatorTypes(data.operatorTypes)
        && hasValidOptionalReference(data.linkedUserUid)
        && data.status in ['active', 'disabled']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedAt >= data.createdAt
        && data.createdByUid is string
        && data.createdByUid.size() > 0
        && data.createdByUid.size() <= 128
        && data.updatedByUid is string
        && data.updatedByUid.size() > 0
        && data.updatedByUid.size() <= 128;
    }

    function usesCurrentWriteTime(data) {
      return data.createdAt <= request.time && data.updatedAt <= request.time;
    }

    function preservesUserHistory() {
      return request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt >= resource.data.updatedAt;
    }

    function preservesPermissionSetHistory() {
      return request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt >= resource.data.updatedAt;
    }

    function usesStudioSettingsCreateMetadata() {
      return request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.updatedByUid == request.auth.uid;
    }

    function preservesStudioSettingsHistory() {
      return request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedAt >= resource.data.updatedAt
        && request.resource.data.updatedByUid == request.auth.uid;
    }

    function usesStudioRoomCreateMetadata() {
      return request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.updatedByUid == request.auth.uid;
    }

    function preservesStudioRoomHistory() {
      return request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedAt >= resource.data.updatedAt
        && request.resource.data.updatedByUid == request.auth.uid;
    }

    function usesOperatorCreateMetadata() {
      return request.resource.data.linkedUserUid == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.updatedByUid == request.auth.uid;
    }

    function preservesOperatorHistoryAndAccountLink() {
      return request.resource.data.linkedUserUid == resource.data.linkedUserUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedAt >= resource.data.updatedAt
        && request.resource.data.updatedByUid == request.auth.uid;
    }

    function preservesOwnOwnerAccess(uid) {
      return uid != request.auth.uid
        || (request.resource.data.role == 'owner'
          && request.resource.data.status == 'active'
          && request.resource.data.permissionSetId == null);
    }

    match /users/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isActiveOwner());
      allow list: if false;

      allow create: if canCreateUserProfile(uid)
        && isValidUserProfile(uid, request.resource.data)
        && usesCurrentWriteTime(request.resource.data);

      allow update: if canUpdateUserProfile(uid, resource.data)
        && isValidUserProfile(uid, request.resource.data)
        && usesCurrentWriteTime(request.resource.data)
        && preservesUserHistory()
        && preservesOwnOwnerAccess(uid);

      allow delete: if false;
    }

    match /permissionSets/{permissionSetId} {
      allow get: if canReadPermissionSet(permissionSetId);
      allow list: if false;

      allow create: if isActiveOwner()
        && isValidPermissionSet(request.resource.data)
        && usesCurrentWriteTime(request.resource.data);

      allow update: if isActiveOwner()
        && isValidPermissionSet(request.resource.data)
        && usesCurrentWriteTime(request.resource.data)
        && preservesPermissionSetHistory();

      allow delete: if false;
    }

    match /appSettings/studio {
      allow get: if isActiveUser();
      allow list: if false;

      allow create: if hasCapability('settings.studio.edit')
        && isValidStudioSettings(request.resource.data)
        && usesStudioSettingsCreateMetadata();

      allow update: if hasCapability('settings.studio.edit')
        && isValidStudioSettings(request.resource.data)
        && preservesStudioSettingsHistory();

      allow delete: if false;
    }

    match /studios/{studioRoomId} {
      allow get: if hasCapability('settings.studio.view');
      allow list: if hasCapability('settings.studio.view')
        && request.query.limit != null
        && request.query.limit <= 50;

      allow create: if hasCapability('settings.studio.edit')
        && isValidStudioRoom(request.resource.data)
        && usesStudioRoomCreateMetadata();

      allow update: if hasCapability('settings.studio.edit')
        && isValidStudioRoom(request.resource.data)
        && preservesStudioRoomHistory();

      allow delete: if false;
    }

    match /operators/{operatorId} {
      allow get: if hasCapability('settings.operators.view');
      allow list: if hasCapability('settings.operators.view')
        && request.query.limit != null
        && request.query.limit <= 100;

      allow create: if hasCapability('settings.operators.manage')
        && isValidOperator(request.resource.data)
        && usesOperatorCreateMetadata();

      allow update: if hasCapability('settings.operators.manage')
        && isValidOperator(request.resource.data)
        && preservesOperatorHistoryAndAccountLink();

      allow delete: if false;
    }

    match /studio37System/connectivity-probe {
      allow get: if isActiveOwner();
      allow list, create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
